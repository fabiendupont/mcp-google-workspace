{
  "server": {
    "project_id": "$GWS_PROJECT_ID"
  },
  "services": [
    {
      "name": "drive",
      "constraints": [
        {
          "param": "parents",
          "values": ["$GWS_TEST_FOLDER_ID"],
          "access": "read-write",
          "location": "body-write-only",
          "mode": "restrict",
          "recursive": true
        }
      ]
    },
    {
      "name": "docs",
      "constraints": [
        {
          "param": "documentId",
          "values": ["1Ffn60EwUK_HgpUjMPs1T11t1nxFoI4kkAm4_N9E1L-I"],
          "access": "read-only",
          "mode": "protect"
        }
      ]
    },
    {
      "name": "sheets"
    },
    {
      "name": "gmail",
      "allowed_labels": ["GWS-MCP-Test"],
      "denied_methods": [
        "messages.delete", "messages.trash", "messages.batchDelete",
        "messages.send", "drafts.send",
        "settings.updateAutoForwarding",
        "settings.delegates.create",
        "settings.forwardingAddresses.create"
      ]
    },
    {
      "name": "people",
      "read_only": true
    },
    {
      "name": "calendar",
      "constraints": [
        { "param": "calendarId", "values": ["primary"], "access": "read-write" }
      ]
    },
    {
      "name": "slides",
      "constraints": [
        {
          "param": "presentationId",
          "values": ["1K6h_BXE4Y8FuJ78Q-qmpUJF4mAMdZDrzxepbSbMMtNY"],
          "access": "read-only",
          "mode": "protect"
        }
      ]
    }
  ],
  "templates": [
    {
      "id": "1K6h_BXE4Y8FuJ78Q-qmpUJF4mAMdZDrzxepbSbMMtNY",
      "name": "standard",
      "description": "Red Hat standard presentation"
    }
  ]
}
